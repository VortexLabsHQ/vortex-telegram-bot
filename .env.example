# Vortex Telegram Bot — example configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` — it holds secrets.
# All values below are FAKE samples. Anything not set here falls back
# to the built-in default shown in the comment.

# ---------------------------------------------------------------- Telegram
# Bot token from @BotFather. REQUIRED.
BOT_TOKEN=1234567890:AAFakeFakeFakeFakeFakeFakeFakeFakeFake
# Your numeric Telegram user ID (the bot owner / "boss"). REQUIRED.
# Find yours with @userinfobot.
BOSS_ID=123456789

# ---------------------------------------------------------------- Bot identity
# BOT_NAME is the bot's name AND its wake word in groups: users say this
# name to talk to it (default "Vortex"). Any language is fine.
BOT_NAME=Vortex
# BOT_COUNTRY is the install-time default country (English name, e.g.
# "United States", "Iran", "Belgium"). It sets the timezone, prices
# (gold/oil in the local currency), prayer times and local content.
# Changeable later from the hidden /admin panel (Language & Country).
BOT_COUNTRY=United States
# BOT_LANGUAGE is the install-time default language (2-letter code, e.g.
# "en", "fa", "tr"). It only changes what the bot says. Changeable later
# from the hidden /admin panel (Language & Country).
BOT_LANGUAGE=en

# ---------------------------------------------------------------- LLM (chat)
# Multi-provider pool: comma-separated entries, each
# base_url|api_key|model. When set, this is the source of truth for the
# token pool; the bot rotates and fails over between providers.
# Example: two providers, e.g. OpenRouter + a TokenHarbor-style aggregator.
LLM_PROVIDERS=https://openrouter.ai/api/v1|sk-or-fake-key-1|openai/gpt-4o-mini,https://api.example-aggregator.com/v1|fake-key-2|provider/model-name
# If LLM_PROVIDERS is empty, providers are built from these instead:
# Single API key (legacy fallback for LLM_API_KEYS).
LLM_API_KEY=sk-fake-single-key
# Multiple keys for rotation/failover, comma-separated.
LLM_API_KEYS=sk-fake-key-1,sk-fake-key-2
# Base URL and default model used with the single/multi-key fallback.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Pinned chat model: when set, the pool keeps this model active while it
# is healthy (no random rotation). Empty = rotate freely.
LLM_PINNED_MODEL=
# Manual selection from /admin (base_url|model). Wins over the pinned
# model while healthy. Normally left empty; /admin manages it.
LLM_MANUAL_SELECTION=
# Vision model used for analysing images (defaults to LLM_MODEL).
LLM_VISION_MODEL=gpt-4o-mini
# Sampling temperature (0.0-2.0) and max reply tokens.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ------------------------------------------------- Token pool health checks
# Seconds between health checks of every key (min 60). Default 1800.
TOKEN_HEALTH_CHECK_INTERVAL_SECONDS=1800
# JSON file where dead/quarantined keys are stored.
TOKEN_DEAD_PATH=data/dead_tokens.json
# Seconds between re-tests of quarantined keys (min 300). Default 36000.
TOKEN_DEAD_RETRY_INTERVAL_SECONDS=36000

# ------------------------------------------------- Antigravity (LEGACY)
# The local `agy` CLI provider is legacy and OFF by default. It is kept
# only for setups that already run the Antigravity CLI on the same host.
# Most deployments should leave AGY_ENABLED=false and use LLM_PROVIDERS.
# NOTE: there is no AGY_MODELS variable — the code does not read one.
AGY_ENABLED=false
# Seconds to wait for an `agy` answer before falling back to the pool.
AGY_TIMEOUT_SECONDS=20

# ------------------------------------------------------------ Image service
# There is no built-in image provider. The owner adds their own image
# service (base URL + API key + model) from the /admin panel; nothing
# to configure here.

# ------------------------------------------------------------------ Search
# Web search provider: searxng (self-hosted, no key), tavily, or serper.
SEARCH_PROVIDER=searxng
# API key for Tavily or Serper (whichever SEARCH_PROVIDER names).
# Not needed for searxng.
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# ------------------------------------------------------- Dollar-rate sources
# The bot tries these in order for USD rates. The primary URL is expected
# to end with "api_key=" — append your Navasan API key there if you use it.
DOLLAR_PRIMARY_URL=https://api.navasan.tech/latest/?api_key=
DOLLAR_FALLBACK_URL=https://alanchand.com/currencies-price/usd
DOLLAR_SECOND_FALLBACK_URL=https://www.tgju.org/profile/price_dollar_rl
# Seconds to cache the fetched rate (5-600). Default 45.
DOLLAR_CACHE_TTL_SECONDS=45

# ------------------------------------------------------------------- Admin
# Ban everyone by default when a ban command runs? (false = per-group.)
GLOBAL_BAN_DEFAULT=false
# Comma-separated trigger words for the ban / unban commands.
BAN_COMMANDS=بن,بن کن,بنش کن
UNBAN_COMMANDS=انبنش کن,آنبن,انبن

# ------------------------------------------------------------ Self-update
# Daily check against the latest GitHub release. The check uses the
# unauthenticated GitHub API, so it only works while the repo is
# public; while it is private the check silently does nothing.
# Set UPDATE_CHECK_ENABLED=0 to disable the check entirely.
UPDATE_CHECK_ENABLED=1
# "owner/repo" whose releases the updater watches.
UPDATE_REPO=VortexLabsHQ/vortex-telegram-bot

# ------------------------------------------------------------ Memory & data
# SQLite database path (relative to the repo root).
DATABASE_PATH=data/vortex_bot.db
# Chat messages kept per user/group before summarising.
MAX_CONTEXT_MESSAGES=12
# Messages after which a rolling summary is written.
SUMMARY_TRIGGER_MESSAGES=16
# Store file summaries in the chat context (true/false).
STORE_FILE_SUMMARY_IN_CONTEXT=true

# ------------------------------------------------- Rate limits (boss exempt)
RATE_LIMIT_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=60
# Max bot replies per user per day (boss exempt).
DAILY_LIMIT_MESSAGES=30

# ------------------------------------------------- File processing & workspace
# Root for temporary per-user workspaces.
TEMP_WORKSPACE_ROOT=/tmp/vortex_workspaces
# Max lifetime of a temp workspace in seconds (capped at 600).
WORKSPACE_TTL_SECONDS=600
# Max size of a file the bot will download/process, in MB.
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=30
MAX_TABLE_ROWS=500
MAX_EXTRACTED_CHARS=18000
FILE_PROCESS_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------- Paths
# System prompt file (relative to the repo root).
SYSTEM_PROMPT_PATH=prompts/system_prompt.txt
# Optional: explicit path to the .env file the bot should read.
# (Used by tests; normally leave unset.)
VORTEX_BOT_ENV=
